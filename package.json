{
  "name": "andrewensley-com",
  "version": "1.0.0",
  "scripts": {
    "copy:functions": "rm -rf functions && cp -r src/functions functions",
    "dev": "next dev --port 5050",
    "build": "npm run copy:functions && next build",
    "build:sourcemaps": "npm run copy:functions && GENERATE_SOURCEMAPS=true next build",
    "preview": "npx serve out -l 4040",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint --fix . && prettier --write .",
    "pre-commit-msg": "echo Running pre-commit checks...",
    "check:update": "npx npm-check-updates",
    "update:all": "npx npm-check-updates -u && npm update"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "highlight.js": "^11.11.1",
    "next": "^16.2.7",
    "next-mdx-remote": "^6.0.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.35.0",
    "eslint-config-love": "^154.0.0",
    "eslint-config-prettier": "^10.1.8",
    "pre-commit": "^2.0.0",
    "typescript-eslint": "^8.60.1",
    "prettier": "^3.8.3",
    "sass": "^1.100.0",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "lodash": "^4.18.1",
    "postcss": "^8.5.10",
    "tmp": "^0.2.6"
  },
  "pre-commit": {
    "run": [
      "pre-commit-msg",
      "lint"
    ],
    "silent": true,
    "colors": true
  },
  "engines": {
    "node": ">= 22.14"
  },
  "prettier": {
    "tabWidth": 2,
    "printWidth": 120,
    "useTabs": false,
    "endOfLine": "lf",
    "trailingComma": "none",
    "semi": false,
    "singleQuote": true,
    "arrowParens": "always",
    "bracketSameLine": false,
    "bracketSpacing": true,
    "embeddedLanguageFormatting": "auto",
    "htmlWhitespaceSensitivity": "css",
    "insertPragma": false,
    "jsxSingleQuote": true,
    "proseWrap": "preserve",
    "quoteProps": "as-needed",
    "requirePragma": false,
    "vueIndentScriptAndStyle": false
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
