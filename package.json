{
  "name": "andrewensley-com",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 5050",
    "build": "next build",
    "build:sourcemaps": "GENERATE_SOURCEMAPS=true next build",
    "start": "next start",
    "preview": "npx serve out -l 4040",
    "lint": "ts-standard && prettier --check .",
    "lint:fix": "ts-standard --fix && prettier --write .",
    "pre-commit-msg": "echo Running pre-commit checks...",
    "update": "npx npm-check-updates -u && npm update"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "highlight.js": "^11.11.1",
    "next": "^16.2.7",
    "next-mdx-remote": "^6.0.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "prettier": "^3.8.3",
    "sass": "^1.100.0",
    "ts-standard": "^12.0.2",
    "typescript": "^6.0.3"
  },
  "pre-commit": {
    "run": [
      "pre-commit-msg",
      "test"
    ],
    "silent": true,
    "colors": true
  },
  "engines": {
    "node": ">= 22.14"
  },
  "eslintConfig": {
    "extends": "standard-with-typescript",
    "parserOptions": {
      "project": "./tsconfig.json"
    }
  },
  "ts-standard": {
    "globals": [],
    "ignore": [
      "/test/**/*.ts"
    ]
  },
  "prettier": {
    "tabWidth": 2,
    "printWidth": 120,
    "useTabs": false,
    "endOfLine": "lf",
    "trailingComma": "none",
    "semi": false,
    "singleQuote": true,
    "arrowParens": "always",
    "bracketSameLine": true,
    "bracketSpacing": true,
    "embeddedLanguageFormatting": "auto",
    "htmlWhitespaceSensitivity": "css",
    "insertPragma": false,
    "jsxSingleQuote": false,
    "proseWrap": "preserve",
    "quoteProps": "as-needed",
    "requirePragma": false,
    "vueIndentScriptAndStyle": false
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
